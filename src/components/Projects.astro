---
import Card from "./Card.astro";
import EmptyCollectionState from "@/components/EmptyCollectionState.astro";

import { getCollection, type CollectionEntry } from "astro:content";
import { sortProjects } from "@/utils/projects";

const allProjects: CollectionEntry<"projects">[] = sortProjects(
  await getCollection("projects"),
).slice(0, 3);
---

<section id="Projects" class="container mx-auto px-6">
  <div class="mb-12 overflow-hidden">
    <div class="animate-scroll flex">
      <div class="flex shrink-0 whitespace-nowrap">
        {
          Array.from({ length: 10 }).map((_) => (
            <h2 class="heading mr-4 -mb-2 text-5xl uppercase md:mr-8 md:text-9xl">
              work
            </h2>
          ))
        }
      </div>
      <div class="flex shrink-0 whitespace-nowrap" aria-hidden="true">
        {
          Array.from({ length: 10 }).map((_) => (
            <h2 class="heading mr-4 -mb-2 text-5xl uppercase md:mr-8 md:text-9xl">
              work
            </h2>
          ))
        }
      </div>
    </div>
  </div>
  {
    allProjects.length > 0 ? (
      <ul class="not-prose flex flex-col gap-4">
        {allProjects.map((project) => <Card entry={project} />)}
      </ul>
    ) : (
      <EmptyCollectionState
        eyebrow="Work In Progress"
        title="No projects published yet"
        description="Add Markdown entries to `src/content/projects` and they will appear here automatically."
        href="/projects"
        linkLabel="Open projects"
      />
    )
  }
</section>

<style>
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-scroll {
    animation: scroll 15s linear infinite;
  }
</style>
