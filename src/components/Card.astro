---
import MetadataPills from "@/components/blog/MetadataPills.astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props as Props;

const blogEntry =
  entry.collection === "blog" ? (entry as CollectionEntry<"blog">) : undefined;
---

<script>
  const cursorNavigationDelayMs = 220;
  const supportsHoverCursor = window.matchMedia(
    "(hover: hover) and (pointer: fine)",
  ).matches;

  type PreviewState = "hover" | "pressed";

  document.querySelectorAll<HTMLAnchorElement>(".card-link").forEach((card) => {
    if (!supportsHoverCursor) {
      return;
    }

    const circle = card.querySelector(
      "[data-cursor-circle]",
    ) as HTMLElement | null;
    const cursorHoverImage = card.querySelector(
      "[data-cursor-hover-image]",
    ) as HTMLImageElement | null;
    const cursorClickImage = card.querySelector(
      "[data-cursor-click-image]",
    ) as HTMLImageElement | null;

    if (!circle || !cursorHoverImage || !cursorClickImage) {
      return;
    }

    const cursorCircle: HTMLElement = circle;
    let targetX: number = 0;
    let targetY: number = 0;
    let currentX: number = 0;
    let currentY: number = 0;
    let isHovering: boolean = false;
    let isNavigating: boolean = false;
    let hasPrimaryMousePress: boolean = false;
    let animationFrameId: number | null = null;

    function setPreviewState(state: PreviewState): void {
      cursorCircle.dataset.previewState = state;
    }

    function resetPreviewState(): void {
      hasPrimaryMousePress = false;

      if (!isNavigating) {
        setPreviewState("hover");
      }
    }

    card.addEventListener("mouseenter", (e: MouseEvent) => {
      const rect: DOMRect = card.getBoundingClientRect();
      targetX = e.clientX - rect.left;
      targetY = e.clientY - rect.top;
      currentX = targetX;
      currentY = targetY;
      cursorCircle.style.left = `${currentX}px`;
      cursorCircle.style.top = `${currentY}px`;
      cursorCircle.style.opacity = "1";
      setPreviewState(isNavigating ? "pressed" : "hover");
      isHovering = true;
      if (!animationFrameId) {
        animateCursor();
      }
    });

    card.addEventListener("mousemove", (e: MouseEvent) => {
      const rect: DOMRect = card.getBoundingClientRect();
      targetX = e.clientX - rect.left;
      targetY = e.clientY - rect.top;
    });

    card.addEventListener("mouseleave", () => {
      isHovering = false;
      hasPrimaryMousePress = false;
      if (!isNavigating) {
        cursorCircle.style.opacity = "0";
        setPreviewState("hover");
      }
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
    });

    card.addEventListener("pointerdown", (e: PointerEvent) => {
      if (e.pointerType === "mouse" && e.button === 0) {
        hasPrimaryMousePress = true;
        setPreviewState("pressed");
      }
    });

    card.addEventListener("pointercancel", () => {
      resetPreviewState();
    });

    card.addEventListener("click", (e: MouseEvent) => {
      const isPrimaryClick =
        e.button === 0 && !e.metaKey && !e.ctrlKey && !e.shiftKey && !e.altKey;
      const opensNewContext = card.target !== "" && card.target !== "_self";
      const shouldDelayNavigation = hasPrimaryMousePress && isPrimaryClick;

      if (!shouldDelayNavigation || opensNewContext) {
        resetPreviewState();
        return;
      }

      hasPrimaryMousePress = false;
      e.preventDefault();
      isNavigating = true;
      setPreviewState("pressed");
      cursorCircle.style.opacity = "1";

      window.setTimeout(() => {
        window.location.assign(card.href);
      }, cursorNavigationDelayMs);
    });

    function animateCursor(): void {
      if (!isHovering) return;
      const speed: number = 0.1;
      currentX += (targetX - currentX) * speed;
      currentY += (targetY - currentY) * speed;

      cursorCircle.style.left = `${currentX}px`;
      cursorCircle.style.top = `${currentY}px`;

      animationFrameId = requestAnimationFrame(animateCursor);
    }
  });
</script>

<li class="space-y-4">
  <a
    class="card-link group border-b-secondary relative flex flex-col items-center justify-between gap-8 border-b border-dashed pb-8 md:flex-row md:gap-12"
    href={`/${entry.collection}/${entry.id}`}
  >
    <div
      data-cursor-circle
      data-preview-state="hover"
      class="pointer-events-none absolute top-0 left-0 z-20 hidden w-[110px] -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-150 ease-out group-hover:grid sm:w-[130px] md:w-[150px]"
      aria-hidden="true"
    >
      <img
        data-cursor-hover-image
        src="/fly_0.webp"
        alt=""
        width="400"
        height="283"
        class="col-start-1 row-start-1 block h-auto w-full object-contain opacity-0 transition-opacity duration-75 ease-out select-none"
        draggable="false"
      />
      <img
        data-cursor-click-image
        src="/fly_1.webp"
        alt=""
        width="400"
        height="331"
        class="col-start-1 row-start-1 block h-auto w-full object-contain opacity-0 transition-opacity duration-75 ease-out select-none"
        draggable="false"
      />
    </div>

    <div
      class="border-secondary aspect-[610/400] w-full overflow-hidden rounded-3xl border-dashed md:max-w-[610px]"
    >
      <img
        src={entry.data.image?.url ||
          `https://placehold.co/600x400?text=${entry.data.title}`}
        alt={entry.data.image?.alt || entry.data.title}
        class="h-full w-full object-cover"
      />
    </div>

    <div class="space-y-4 text-center md:text-left">
      <h3 class="heading line-clamp-2 max-w-xl text-2xl uppercase md:text-4xl">
        {entry.data.title}
      </h3>
      <p
        class="text-secondary mx-auto line-clamp-3 max-w-xl text-lg md:mx-0 md:text-2xl"
      >
        {entry.data.description}
      </p>
    </div>
  </a>

  {
    blogEntry && (
      <div class="pl-1">
        <MetadataPills
          tags={blogEntry.data.tags}
          series={blogEntry.data.series}
          compact={true}
        />
      </div>
    )
  }
</li>

<style>
  [data-preview-state="hover"] [data-cursor-hover-image],
  [data-preview-state="pressed"] [data-cursor-click-image] {
    opacity: 1;
  }
</style>
