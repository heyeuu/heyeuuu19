---
import MetadataPills from "@/components/blog/MetadataPills.astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props as Props;

const blogEntry =
  entry.collection === "blog" ? (entry as CollectionEntry<"blog">) : undefined;
---

<script>
  document
    .querySelectorAll<HTMLElement>(".card-link")
    .forEach((card: HTMLElement) => {
      const cardElement: HTMLElement = card;
      const circle = cardElement.querySelector(
        "[data-cursor-circle]",
      ) as HTMLElement | null;

      if (!circle) {
        return;
      }

      let targetX: number = 0;
      let targetY: number = 0;
      let currentX: number = 0;
      let currentY: number = 0;
      let isHovering: boolean = false;
      let animationFrameId: number | null = null;

      cardElement.addEventListener("mouseenter", (e: MouseEvent) => {
        const rect: DOMRect = cardElement.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
        currentX = targetX;
        currentY = targetY;
        circle.style.left = `${currentX}px`;
        circle.style.top = `${currentY}px`;
        circle.style.opacity = "1";
        isHovering = true;
        if (!animationFrameId) {
          animateCursor();
        }
      });

      cardElement.addEventListener("mousemove", (e: MouseEvent) => {
        const rect: DOMRect = cardElement.getBoundingClientRect();
        targetX = e.clientX - rect.left;
        targetY = e.clientY - rect.top;
      });

      cardElement.addEventListener("mouseleave", () => {
        isHovering = false;
        circle.style.opacity = "0";
        if (animationFrameId) {
          cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
      });

      function animateCursor(): void {
        if (!isHovering) return;
        const speed: number = 0.1;
        currentX += (targetX - currentX) * speed;
        currentY += (targetY - currentY) * speed;

        circle.style.left = `${currentX}px`;
        circle.style.top = `${currentY}px`;

        animationFrameId = requestAnimationFrame(animateCursor);
      }
    });
</script>

<li class="space-y-4">
  <a
    class="card-link group border-b-secondary relative flex flex-col items-center justify-between gap-8 border-b border-dashed pb-8 md:flex-row md:gap-12"
    href={`/${entry.collection}/${entry.id}`}
  >
    <div
      data-cursor-circle
      class="border-secondary bg-primary pointer-events-none absolute hidden h-[75px] w-[75px] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-dashed group-hover:grid"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        class="text-accent h-10 w-10"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M7 7h10v10"></path>
        <path d="M7 17 17 7"></path>
      </svg>
    </div>

    <div
      class="border-secondary aspect-[610/400] w-full overflow-hidden rounded-3xl border-dashed md:max-w-[610px]"
    >
      <img
        src={entry.data.image?.url ||
          `https://placehold.co/600x400?text=${entry.data.title}`}
        alt={entry.data.image?.alt || entry.data.title}
        class="h-full w-full object-cover"
      />
    </div>

    <div class="space-y-4 text-center md:text-left">
      <h3 class="heading line-clamp-2 max-w-xl text-2xl uppercase md:text-4xl">
        {entry.data.title}
      </h3>
      <p
        class="text-secondary mx-auto line-clamp-3 max-w-xl text-lg md:mx-0 md:text-2xl"
      >
        {entry.data.description}
      </p>
    </div>
  </a>

  {
    blogEntry && (
      <div class="pl-1">
        <MetadataPills
          tags={blogEntry.data.tags}
          series={blogEntry.data.series}
          compact={true}
        />
      </div>
    )
  }
</li>
