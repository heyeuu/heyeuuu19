---
import { SITE, SOCIALS } from "@/consts";
import { getCollection, type CollectionEntry } from "astro:content";
import { sortProjects } from "@/utils/projects";

const projects: CollectionEntry<"projects">[] = sortProjects(
  await getCollection("projects"),
).slice(0, 3);
---

<footer class="bg-primary container mx-auto space-y-8 rounded-t-[80px] p-10">
  <div
    class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center"
  >
    <h2 class="text-5xl uppercase lg:text-9xl">{SITE.TITLE}</h2>
    <p class="max-w-[760px] text-2xl lg:text-3xl">
      Simplicity is the ultimate sophistication — especially in code.
    </p>
  </div>
  <div class="flex flex-col justify-between gap-10 sm:flex-row sm:flex-wrap">
    <div>
      <h3 class="mb-2 text-xl">Contact</h3>
      <ul>
        <li><a href="mailto:someone@example.com">{SITE.EMAIL}</a></li>
      </ul>
    </div>
    <div>
      <h3 class="mb-2 text-xl">Navigation</h3>
      <ul class="text-secondary space-y-1">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
    <div>
      <h3 class="mb-2 text-xl">Socials</h3>
      <ul class="text-secondary space-y-1">
        {
          SOCIALS.map((link) => (
            <li>
              <a href={link.HREF}>{link.NAME}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3 class="mb-2 text-xl">Projects</h3>
      <ul class="text-secondary space-y-1">
        {
          projects.map((project) => (
            <li>
              <a href={`/projects/${project.id}`}>{project.data.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <span class="block text-center text-sm opacity-70">
    © {SITE.TITLE}. Built with Astro
  </span>
</footer>
