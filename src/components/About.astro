---
import { ABOUT } from "@/consts";
---

<section id="About" class="container mx-auto mb-28 p-6">
  <h2 class="heading text-5xl md:text-9xl uppercase">{ABOUT.TITLE}</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 items-center md:p-0 gap-8">
    <div class="space-y-6">
      <div
        class="w-full aspect-[668/516] md:max-w-[668px] overflow-hidden rounded-3xl"
      >
        <img
          src={ABOUT.IMAGE.SRC}
          alt={ABOUT.IMAGE.ALT}
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <div>
      <div class="text-lg md:text-2xl text-secondary space-y-4">
        {ABOUT.PARAGRAPHS.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div>
        <h3 class="heading text-2xl uppercase my-8 text-secondary">
          {ABOUT.SKILLS_TITLE}
        </h3>
        <div class="flex flex-wrap gap-4 mt-8">
          {
            ABOUT.SKILLS.map((skill) => (
              <span class="inline-flex items-center justify-center rounded-4xl py-4 px-8 outline-1 outline-dashed outline-secondary">
                {skill}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
