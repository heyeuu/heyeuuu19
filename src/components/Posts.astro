---
import Card from "./Card.astro";
import EmptyCollectionState from "@/components/EmptyCollectionState.astro";

import { getCollection, type CollectionEntry } from "astro:content";
import { getPublishedBlogPosts } from "@/utils/blog";

const allPosts: CollectionEntry<"blog">[] = getPublishedBlogPosts(
  await getCollection("blog"),
).slice(0, 3);
---

<section id="Posts" class="container mx-auto mt-18 px-6">
  <div class="mb-12 overflow-hidden">
    <div class="animate-scroll flex">
      <div class="flex shrink-0 whitespace-nowrap">
        {
          Array.from({ length: 10 }).map((_) => (
            <h2 class="heading mr-4 -mb-2 text-5xl uppercase md:mr-8 md:text-9xl">
              Posts
            </h2>
          ))
        }
      </div>
      <div class="flex shrink-0 whitespace-nowrap" aria-hidden="true">
        {
          Array.from({ length: 10 }).map((_) => (
            <h2 class="heading mr-4 -mb-2 text-5xl uppercase md:mr-8 md:text-9xl">
              Posts
            </h2>
          ))
        }
      </div>
    </div>
  </div>
  {
    allPosts.length > 0 ? (
      <ul class="not-prose flex flex-col gap-4">
        {allPosts.map((post) => <Card entry={post} />)}
      </ul>
    ) : (
      <EmptyCollectionState
        eyebrow="Archive Empty"
        title="No published posts yet"
        description="This section fills automatically once `src/content/blog` contains non-draft Markdown entries."
        href="/blog"
        linkLabel="Open the blog archive"
      />
    )
  }
</section>

<style>
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-scroll {
    animation: scroll 15s linear infinite;
  }
</style>
