---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import EmptyCollectionState from "@/components/EmptyCollectionState.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { PROJECTS } from "@/consts";
import { sortProjects } from "@/utils/projects";

const allProjects: CollectionEntry<"projects">[] =
  await getCollection("projects");
const allProjectsSorted = sortProjects(allProjects);
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <section id="Projects" class="container mx-auto px-6 pt-18">
    <h2 class="heading my-8 mr-4 text-5xl uppercase md:mr-8 md:text-9xl">
      work
    </h2>
    {
      allProjectsSorted.length > 0 ? (
        <ul class="not-prose flex flex-col gap-4">
          {allProjectsSorted.map((project) => (
            <Card entry={project} />
          ))}
        </ul>
      ) : (
        <EmptyCollectionState
          eyebrow="Work In Progress"
          title="No projects published yet"
          description="The projects index is live, but `src/content/projects` is currently empty."
          href="/"
          linkLabel="Back to home"
        />
      )
    }
  </section>
</Layout>
