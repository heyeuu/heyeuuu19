---
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import TaxonomyDirectory from "@/components/blog/TaxonomyDirectory.astro";
import { getCollection } from "astro:content";
import { BLOG } from "@/consts";
import {
  getPublishedBlogPosts,
  getSeriesGroups,
  getTagGroups,
  groupPostsByYear,
  sortTaxonomyGroupsByUsage,
} from "@/utils/blog";

const posts = getPublishedBlogPosts(await getCollection("blog"));
const postsByYear = groupPostsByYear(posts);
const tagGroups = getTagGroups(posts);
const seriesGroups = getSeriesGroups(posts);
const popularTags = sortTaxonomyGroupsByUsage(tagGroups).slice(0, 8);
const featuredSeries = seriesGroups.slice(0, 6);
---

<Layout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <section id="Blog" class="container mx-auto space-y-12 px-6 pt-18">
    <div class="space-y-6">
      <h2 class="heading my-8 mr-4 text-5xl uppercase md:mr-8 md:text-9xl">
        Blog
      </h2>

      <div class="grid gap-4 lg:grid-cols-[minmax(0,2fr)_minmax(280px,1fr)]">
        <div
          class="border-secondary/60 bg-background/85 space-y-6 rounded-[2rem] border border-dashed p-6 md:p-8"
        >
          <div class="space-y-3">
            <p class="text-secondary text-xs tracking-[0.3em] uppercase">
              Archive
            </p>
            <h3 class="heading text-2xl uppercase md:text-4xl">
              Browse by year, topic, or series.
            </h3>
            <p class="text-secondary max-w-2xl">
              Tags group posts by topic. Series connect posts that are meant to
              be read together.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-3">
            <div
              class="border-secondary/50 rounded-[1.5rem] border border-dashed p-4"
            >
              <p class="text-secondary text-xs tracking-[0.2em] uppercase">
                Posts
              </p>
              <p class="heading mt-3 text-3xl">{posts.length}</p>
            </div>
            <div
              class="border-secondary/50 rounded-[1.5rem] border border-dashed p-4"
            >
              <p class="text-secondary text-xs tracking-[0.2em] uppercase">
                Tags
              </p>
              <p class="heading mt-3 text-3xl">{tagGroups.length}</p>
            </div>
            <div
              class="border-secondary/50 rounded-[1.5rem] border border-dashed p-4"
            >
              <p class="text-secondary text-xs tracking-[0.2em] uppercase">
                Series
              </p>
              <p class="heading mt-3 text-3xl">{seriesGroups.length}</p>
            </div>
          </div>
        </div>

        <div class="grid gap-4">
          <a
            href="/blog/tags"
            class="border-secondary/60 bg-primary/45 hover:bg-primary/65 flex items-center justify-between rounded-[2rem] border border-dashed p-6 transition-colors"
          >
            <div class="space-y-2">
              <p class="text-secondary text-xs tracking-[0.3em] uppercase">
                Topics
              </p>
              <h3 class="heading text-2xl uppercase">All Tags</h3>
            </div>
            <span class="heading text-3xl">{tagGroups.length}</span>
          </a>

          <a
            href="/blog/series"
            class="border-secondary/60 bg-background/85 hover:border-foreground/40 hover:bg-primary/18 flex items-center justify-between rounded-[2rem] border border-dashed p-6 transition-colors"
          >
            <div class="space-y-2">
              <p class="text-secondary text-xs tracking-[0.3em] uppercase">
                Reading Paths
              </p>
              <h3 class="heading text-2xl uppercase">All Series</h3>
            </div>
            <span class="heading text-3xl">{seriesGroups.length}</span>
          </a>
        </div>
      </div>
    </div>

    <div class="grid gap-10">
      <TaxonomyDirectory
        title="Popular Tags"
        description="Jump across themes and recurring topics."
        groups={popularTags}
        kind="tag"
        limit={8}
      />
      <TaxonomyDirectory
        title="Series"
        description="Follow posts that belong to the same long-form thread."
        groups={featuredSeries}
        kind="series"
        limit={6}
      />
    </div>

    <section class="space-y-10">
      {
        postsByYear.map(({ year, posts: yearPosts }) => (
          <section class="animate space-y-4">
            <h4 class="heading text-2xl lg:text-4xl">{year}</h4>
            <ul class="not-prose flex flex-col gap-4">
              {yearPosts.map((post) => (
                <Card entry={post} />
              ))}
            </ul>
          </section>
        ))
      }
    </section>
  </section>
</Layout>
