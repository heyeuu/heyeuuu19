---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import TableOfContents from "@/components/table-of-contents/index.astro";
import TableOfContentsObserver from "@/components/table-of-contents/Observer.astro";
import MetadataPills from "@/components/blog/MetadataPills.astro";
import PostPageviews from "@/components/blog/PostPageviews.astro";
import SeriesPosts from "@/components/blog/SeriesPosts.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import {
  getTableOfContentsHeadings,
  shouldRenderTableOfContents,
} from "@/components/table-of-contents/utils";
import {
  getPublishedBlogPosts,
  getSeriesPosts,
  sortBlogPosts,
} from "@/utils/blog";

export async function getStaticPaths() {
  const posts = getPublishedBlogPosts(await getCollection("blog"));
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props as Props;
const allPosts = getPublishedBlogPosts(await getCollection("blog"));
const hasPageviews = Boolean(import.meta.env.PUBLIC_UMAMI_STATS_API_URL);
const hasMetadata =
  Boolean(post.data.series) || (post.data.tags?.length ?? 0) > 0;
const postsByDate = sortBlogPosts(allPosts);
const currentIndex = postsByDate.findIndex((entry) => entry.id === post.id);
const newerPost = currentIndex > 0 ? postsByDate[currentIndex - 1] : undefined;
const olderPost =
  currentIndex >= 0 && currentIndex < postsByDate.length - 1
    ? postsByDate[currentIndex + 1]
    : undefined;
const seriesPosts = post.data.series
  ? getSeriesPosts(allPosts, post.data.series)
  : [];
const relatedPosts = sortBlogPosts(
  allPosts.filter((entry) => {
    if (entry.id === post.id) {
      return false;
    }

    const currentTags = post.data.tags ?? [];
    const nextTags = entry.data.tags ?? [];
    return nextTags.some((tag) => currentTags.includes(tag));
  }),
).slice(0, 3);

const { Content, headings } = await render(post);
const tocHeadings = getTableOfContentsHeadings(headings);
const hasTableOfContents = shouldRenderTableOfContents(tocHeadings);
---

<Layout title={post.data.title} description={post.data.description}>
  <div class="container mx-auto space-y-10 px-6 pt-18">
    <button
      class="text-secondary hover:text-primary my-6 flex cursor-pointer items-center gap-2 pl-2"
      title="back"
      id="back-button"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-move-left-icon lucide-move-left"
        ><path d="M6 8L2 12L6 16"></path><path d="M2 12H22"></path></svg
      >
      <span>Back</span>
    </button>
    <div
      class="border-secondary flex flex-col gap-4 border-b border-dashed pb-6 md:flex-row md:items-end md:justify-between"
    >
      <div class="space-y-5">
        <div class="space-y-4">
          <h1 class="heading text-3xl uppercase md:text-5xl">
            {post.data.title}
          </h1>
          <p class="max-w-3xl">{post.data.description}</p>
        </div>

        <div class="flex flex-col gap-3">
          <p class="text-secondary">
            <FormattedDate date={post.data.date} />
          </p>
          <MetadataPills tags={post.data.tags} series={post.data.series} />
        </div>
      </div>

      <div class="text-secondary flex flex-wrap gap-3 text-sm">
        <a
          href="/blog/tags"
          class="hover:text-foreground underline decoration-dashed underline-offset-4 transition-colors"
        >
          All tags
        </a>
        <a
          href="/blog/series"
          class="hover:text-foreground underline decoration-dashed underline-offset-4 transition-colors"
        >
          All series
        </a>
      </div>
    </div>
    {
      hasTableOfContents && (
        <TableOfContents headings={tocHeadings} collapsible />
      )
    }
    {hasTableOfContents && <TableOfContentsObserver />}

    <div
      class:list={[
        "grid gap-10",
        hasTableOfContents && "xl:grid-cols-[minmax(0,1fr)_18rem]",
      ]}
    >
      <article class="mx-auto min-w-0 px-3">
        <Content />
      </article>

      {
        hasTableOfContents && (
          <aside class="hidden xl:block xl:self-stretch">
            <div
              data-toc-scroll-container
              class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto"
            >
              <TableOfContents headings={tocHeadings} />
            </div>
          </aside>
        )
      }
    </div>

    <section class="space-y-6">
      <section
        class="border-secondary/60 bg-background/90 space-y-5 rounded-[2rem] border border-dashed p-6 md:p-8"
      >
        <div class="space-y-2">
          <p class="text-secondary text-xs tracking-[0.3em] uppercase">
            After Reading
          </p>
          <h2 class="heading text-2xl uppercase md:text-4xl">Post Notes</h2>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          <div
            class="border-secondary/50 rounded-[1.5rem] border border-dashed p-4"
          >
            <p class="text-secondary text-xs tracking-[0.2em] uppercase">
              Published
            </p>
            <p class="heading mt-3 text-xl uppercase md:text-2xl">
              <FormattedDate date={post.data.date} />
            </p>
          </div>

          <div
            class="border-secondary/50 rounded-[1.5rem] border border-dashed p-4"
          >
            <p class="text-secondary text-xs tracking-[0.2em] uppercase">
              Topics
            </p>
            <div class="mt-3">
              {
                hasMetadata ? (
                  <MetadataPills
                    tags={post.data.tags}
                    series={post.data.series}
                  />
                ) : (
                  <p class="text-secondary">No tags or series assigned.</p>
                )
              }
            </div>
          </div>

          <div
            class="border-secondary/50 rounded-[1.5rem] border border-dashed p-4"
          >
            <p class="text-secondary text-xs tracking-[0.2em] uppercase">
              Reach
            </p>
            <div class="mt-3">
              {
                hasPageviews ? (
                  <PostPageviews postId={post.id} />
                ) : (
                  <p class="text-secondary">Pageview tracking is disabled.</p>
                )
              }
            </div>
          </div>
        </div>
      </section>

      {
        (newerPost || olderPost) && (
          <section class="border-secondary/60 bg-background/90 space-y-5 rounded-[2rem] border border-dashed p-6 md:p-8">
            <div class="space-y-2">
              <p class="text-secondary text-xs tracking-[0.3em] uppercase">
                Continue Reading
              </p>
              <h2 class="heading text-2xl uppercase md:text-4xl">
                Nearby Posts
              </h2>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              {newerPost && (
                <a
                  href={`/blog/${newerPost.id}`}
                  class="border-secondary/50 bg-background/70 hover:border-foreground/40 hover:bg-primary/18 space-y-3 rounded-[1.5rem] border border-dashed p-5 transition-colors"
                >
                  <p class="text-secondary text-xs tracking-[0.25em] uppercase">
                    Newer Post
                  </p>
                  <p class="heading text-xl uppercase md:text-2xl">
                    {newerPost.data.title}
                  </p>
                  <p class="text-secondary">{newerPost.data.description}</p>
                </a>
              )}

              {olderPost && (
                <a
                  href={`/blog/${olderPost.id}`}
                  class="border-secondary/50 bg-background/70 hover:border-foreground/40 hover:bg-primary/18 space-y-3 rounded-[1.5rem] border border-dashed p-5 transition-colors"
                >
                  <p class="text-secondary text-xs tracking-[0.25em] uppercase">
                    Older Post
                  </p>
                  <p class="heading text-xl uppercase md:text-2xl">
                    {olderPost.data.title}
                  </p>
                  <p class="text-secondary">{olderPost.data.description}</p>
                </a>
              )}
            </div>
          </section>
        )
      }
    </section>

    {
      seriesPosts.length > 1 && (
        <SeriesPosts
          posts={seriesPosts}
          currentId={post.id}
          description={`Continue through the ${post.data.series} series in reading order.`}
        />
      )
    }

    {
      relatedPosts.length > 0 && (
        <section class="border-secondary/60 bg-background/90 space-y-5 rounded-[2rem] border border-dashed p-6 md:p-8">
          <div class="space-y-2">
            <p class="text-secondary text-xs tracking-[0.3em] uppercase">
              Related Topics
            </p>
            <h2 class="heading text-2xl uppercase md:text-4xl">
              More With Similar Tags
            </h2>
          </div>

          <ul class="not-prose flex flex-col gap-4">
            {relatedPosts.map((entry) => (
              <li class="border-secondary/50 border-b border-dashed pb-4 last:border-b-0">
                <a
                  href={`/blog/${entry.id}`}
                  class="text-foreground hover:text-secondary space-y-2 transition-colors"
                >
                  <p class="heading text-xl uppercase">{entry.data.title}</p>
                  <p class="text-secondary max-w-3xl">
                    {entry.data.description}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <script is:inline>
    document.getElementById("back-button").addEventListener("click", () => {
      window.history.back();
    });
  </script>
</Layout>
